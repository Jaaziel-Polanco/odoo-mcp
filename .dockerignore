.github/
.vscode/
.env
.env.*
.env.example

tests/
docs/
assets/
scripts/
architecture.md
CHANGELOG.md
CLAUDE.md
SETUP.md

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
.venv/
venv/

